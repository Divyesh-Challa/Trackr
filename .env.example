# Trackr Configuration

# PostgreSQL & pgvector
POSTGRES_USER=trackr
POSTGRES_PASSWORD=[REDACTED_PASSWORD]
POSTGRES_DB=trackr_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://trackr:[REDACTED_PASSWORD]@localhost:5432/trackr_db?sslmode=disable

# Redis (Queue Broker & Cache)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_SNAPSHOTS=trackr-snapshots
S3_BUCKET_EMAILS=trackr-emails

# Services
GATEWAY_PORT=8080
AI_WORKER_PORT=8000
AI_WORKER_URL=http://localhost:8000

# AI / LLM Integration (Google Gemini Free Tier)
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=
