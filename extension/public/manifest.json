{
  "manifest_version": 3,
  "name": "Trackr Autofill",
  "version": "0.1.0",
  "description": "Fill Greenhouse, Lever and Ashby applications from your Trackr profile and apply kit. You press Submit.",
  "permissions": ["storage", "sidePanel", "activeTab"],
  "host_permissions": ["https://trackr-portal.vercel.app/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Trackr answers" },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://jobs.lever.co/*", "https://jobs.ashbyhq.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
