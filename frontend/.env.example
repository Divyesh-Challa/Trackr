# Local: values printed by `supabase start` (run from the repo root).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Needed by the Stripe webhook and checkout.
SUPABASE_SERVICE_ROLE_KEY=

# Billing (optional). Run `node scripts/stripe-setup.mjs` once to create prices and the webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI tools for Pro (optional). Without a key the AI tab says "coming soon".
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_USD=5
# Or Gemini instead: set AI_PROVIDER=gemini. The free tier may use prompts for training,
# so keep it to local testing with made-up data until billing is on.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Error tracking (optional).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
