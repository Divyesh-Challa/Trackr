# Local: values printed by `supabase start` (run from the repo root).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Needed by the Stripe webhook and checkout.
SUPABASE_SERVICE_ROLE_KEY=

# Billing (optional). Run `node scripts/stripe-setup.mjs` once to create prices and the webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI tools for Pro (optional). Without a key the AI tab says "coming soon".
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_USD=5

# Error tracking (optional).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
